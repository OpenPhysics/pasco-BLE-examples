{
  "name": "pasco-ble",
  "version": "0.3.65",
  "description": "TypeScript library for PASCO wireless BLE sensors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
